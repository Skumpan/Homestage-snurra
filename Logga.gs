/**
 * Loggan "h.e.m staging" (PNG, 640 × 309, bakgrunden är vit).
 * Ligger som text eftersom Apps Script inte kan visa bildfiler från projektet.
 * Byt logga genom att byta ut LOGGA_BASE64 nedan.
 */
var LOGGA_BASE64 = '';

/** Loggan som adress som kan läggas direkt i en <img> på räknesidan. */
function loggaDataUrl() {
  return 'data:image/png;base64,' + LOGGA_BASE64;
}

/** Loggan som bild att bifoga mejlet (visas med <img src="cid:logga">). */
function loggaBlob() {
  return Utilities.newBlob(Utilities.base64Decode(LOGGA_BASE64), 'image/png', 'logga.png');
}
